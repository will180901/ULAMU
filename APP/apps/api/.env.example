# Variables d'environnement de l'API ULAMU — copiez ce fichier en `.env` et remplissez.
# En production, ces valeurs vivent dans le tableau de bord Render (cf. render.yaml à la racine).
# Le `.env` réel est ignoré par git : aucun secret ne doit jamais être commité.

# ── Base de données ────────────────────────────────────────────────────────────────────────────
# Chaîne de connexion Neon (PostgreSQL). C'est LA variable sans laquelle rien ne démarre.
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# Base RÉSERVÉE AUX TESTS — obligatoire pour lancer `npm test`, et elle doit être DIFFÉRENTE de
# DATABASE_URL. Les suites d'intégration vident vingt-quatre tables avant de commencer : sans cette
# séparation, elles effacent les comptes du site en ligne (c'est arrivé le 23/08/2026).
# Une branche Neon suffit et ne coûte rien : console Neon → projet → Branches → Create branch.
# Créez-y les tables une fois, avec DATABASE_URL pointée dessus : npx prisma migrate deploy
TEST_DATABASE_URL="postgresql://user:password@branche-de-test.neon.tech/neondb?sslmode=require"

# ── Chiffrement au repos ───────────────────────────────────────────────────────────────────────
# 32 octets en base64 : openssl rand -base64 32
# Chiffre les messages de session, les médias et les secrets TOTP (AES-256-GCM).
# ⚠️ Non renseignée, le code retombe sur une clé DÉRIVÉE ET ÉCRITE EN CLAIR dans les sources : le
# chiffrement ne protège alors plus rien. Acceptable en développement, jamais en production.
# ⚠️ Un secret scellé avec une clé ne se relit qu'avec la MÊME clé. Changer cette valeur rend
# illisibles tous les secrets déjà enregistrés — c'est ce qui a enfermé un administrateur dehors
# le 20/08/2026, son secret TOTP ayant été scellé en local puis relu par l'API déployée.
SECRETBOX_KEY=""

# ── Envoi des emails (codes de vérification : inscription, mot de passe oublié, 2FA) ───────────
# Brevo est la passerelle ACTIVE : elle livre à n'importe quel destinataire dès qu'un expéditeur est
# vérifié, sans posséder de domaine. C'est ce qui débloque l'inscription réelle.
BREVO_API_KEY=""
BREVO_FROM_EMAIL=""          # l'adresse VÉRIFIÉE dans Brevo (Senders & IP) — sinon Brevo refuse l'envoi
BREVO_FROM_NAME="ULAMU"
# Resend reprendra la main le jour où un domaine ULAMU sera vérifié (il suffira de retirer
# BREVO_API_KEY). Sans domaine, Resend ne livre qu'à l'adresse du compte Resend.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# ── Serveur ────────────────────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT="3000"
API_PORT="3000"
PUBLIC_API_URL="http://localhost:3000"
# Origines autorisées à appeler l'API depuis un navigateur, séparées par des virgules.
CORS_ORIGINS="http://localhost:5173"

# ── Paiement ───────────────────────────────────────────────────────────────────────────────────
MOMO_WEBHOOK_SECRET=""

# ── Sécurité — à repositionner avant toute mise en production ──────────────────────────────────
# Renvoie le code de vérification dans la réponse de l'API. À "true", n'importe qui peut demander un
# code pour un compte et s'en servir pour réinitialiser le mot de passe. Le code refuse de toute
# façon l'écho quand NODE_ENV=production (garde-fou dur).
OTP_ECHO="false"
# RM-01-06 : TOTP obligatoire pour toute action d'administration. "false" lève l'exigence pendant la
# construction. La valeur PAR DÉFAUT du code est l'exigence ACTIVE : oublier de retirer cette ligne
# laisse le système fermé, jamais ouvert.
ADMIN_REQUIRE_TOTP="true"

# ── MODE VITRINE — démonstration sans vrais soignants ni vrai paiement ─────────────────────────
# ⚠️ À RETIRER au lancement réel. Le soignant « accepte » et le paiement « se confirme » tout seuls,
# pour qu'un testeur déroule le parcours complet. Aucun argent réel ne circule.
HANDSHAKE_AUTOCONFIRM_MS=""   # ex. "3000" : le soignant virtuel accepte après 3 s
MOMO_AUTOCONFIRM_MS=""        # ex. "4000" : le paiement se valide après 4 s

# ── Amorçage de la base (`npx prisma migrate reset` ou `npm run prisma:seed`) ──────────────────
# Le compte super-administrateur n'est créé QUE s'il n'existe aucun admin.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="Admin123!"
SEED_ADMIN_PHONE="+242060000001"
# ⚠️ Mettez ici une adresse que vous relevez vraiment. Sans elle, ce compte n'a AUCUNE voie de
# récupération de mot de passe : la réinitialisation par email cherche un compte portant l'adresse
# saisie, et le TOTP n'est plus imposé depuis le 20/08/2026.
SEED_ADMIN_EMAIL="admin@ulamu.cg"
# "false" : le seed ne crée que le super-administrateur et les 40 paramètres métier PM.
# Absente ou "true" : il ajoute aussi patients, soignants, pharmacies et médicaments de démonstration.
SEED_DEMO="false"
