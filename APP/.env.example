# ULAMU — variables d'environnement (modèle)
# Copier en .env (jamais commité) et remplir. AUCUN secret réel dans ce fichier.

# --- Base de données (docker-compose dev) ---
DATABASE_URL="postgresql://ulamu:ulamu_dev_only@localhost:5432/ulamu"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Stockage objet (MinIO en dev, S3-compatible en prod — ADR-07) ---
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="ulamu"
S3_SECRET_KEY="ulamu_dev_only"
S3_BUCKET="ulamu-media"

# --- Passerelle SMS (OTP changement de numéro / action sensible — RM-01-03) ---
SMS_GATEWAY_URL=""
SMS_GATEWAY_KEY=""

# --- Email (OTP inscription/réinitialisation mot de passe, 2026-07 — resend.com) ---
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
# URL publique de CETTE API (sert le logo de l'email OTP en /assets/logo-email.png — doit être
# joignable depuis Internet, donc inutile en dev local ; vide = repli sur l'URL Render de prod).
PUBLIC_API_URL=""

# --- Agrégateur Mobile Money (Chantier 2 — ADR-09, bac à sable d'abord) ---
MOMO_AGGREGATOR_BASE_URL=""
MOMO_AGGREGATOR_KEY=""

# --- Notifications push (FCM — ADR-08) ---
FCM_PROJECT_ID=""
FCM_CREDENTIALS_PATH=""

# --- Application ---
JWT_SECRET="changer_moi_en_dev"
API_PORT=3001

# --- CORS (app web pro/structure/admin, apps/web) — origines séparées par une virgule ---
CORS_ORIGINS="http://localhost:5173"
